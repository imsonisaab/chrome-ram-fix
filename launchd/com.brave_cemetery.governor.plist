<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.brave_cemetery.governor</string>
	<key>ProgramArguments</key>
	<array>
		<string>__GOVERNOR_DAEMON__</string>
		<string>__DAEMON_JS__</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CEMETERY_DIR</key>
		<string>$HOME/Library/Application Support/ChromeCemetery/store</string>
		<key>GOVERNOR_PORT</key>
		<string>8795</string>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/sbin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
		<string>$HOME/Library/Logs/ChromeCemetery/governor.out.log</string>
	<key>StandardErrorPath</key>
		<string>$HOME/Library/Logs/ChromeCemetery/governor.err.log</string>
</dict>
</plist>
