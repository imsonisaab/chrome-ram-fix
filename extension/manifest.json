{
  "manifest_version": 3,
  "key": "",
  "name": "ChromeRAMFix",
  "version": "0.4.0",
  "description": "Level 2 memory governor for Chrome: kernel-pressure-driven tab discard with zero-flash state re-apply. 15% storage floor enforced by the watchdog.",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "nativeMessaging",
    "processes",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8795/pressure"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "embaler/lib/*.js",
        "governor/lib/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "ChromeRAMFix",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
