{
  "manifest_version": 3,
  "key": "",
  "name": "ChromeRAMFix",
  "version": "0.3.0",
  "description": "Cuts Chrome RAM by 80-90%: idle background tabs are compressed to a tiny on-disk snapshot, then discarded. Clicking the tab restores scroll, forms and video position with zero flash.",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:8795/pressure"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "embaler/lib/*.js",
        "governor/lib/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}